{% set os = ansible_facts['distribution'] %}
{% set os_ver = ansible_facts['distribution_version'] %}
{% set hname = inventory_hostname %}
{% set primary_ip = ansible_facts['all_ipv4_addresses'][0] %}
{% set ext_ip = primary_ip %}
{% set int_ip = secondary_ip %}
{% set pools = dnsdist_data[hname]['pools'] %}

-- Generated by Ansible on {{ ansible_date_time.iso8601 }}
-- Do not edit manually: changes will be overwritten by automation.
  
-- Listen Sockets
setLocal("{{localhost}}:{{local_port}}")
addLocal("{{ext_ip}}:53")

-- Control Socket, Console and Webserver
controlSocket("{{localhost}}:{{control_port}}")

setKey('{{console_key}}')
setConsoleACL({
{% for cidr in console_acl %}
  '{{cidr}}',
{% endfor %}
})

-- Webserver Config
webserver("{{ primary_ip }}:8088")
setWebserverConfig({
  password='{{web_pw}}',
  apiKey='{{web_key}}',
  acl='{{web_acl}}'
})

-- Access Control Lists
setACL({
{% for net in uoft_nets %}
  '{{net}}',
{% endfor %}
})


-- Pools

-- Default Pool
{% for nm, ip in pools['default'].items() %}
newServer({ name='{{nm}}', address='{{ip}}', pool='' })
{% endfor %}

-- Local Pool
{% for nm, ip in pools['local'].items() %}
newServer({ name='{{nm}}', address='{{ip}}', pool='local' })
{% endfor %}

newServer({name='cira121', address='149.112.121.10', pool='cira'})
newServer({name='cira122', address='149.112.122.10', pool='cira'})
newServer({name='ans1', address='128.100.235.12', pool='bluecat'})
newServer({name='ans2', address='128.100.213.12', pool='bluecat'})
newServer({name='prod1', address='142.1.78.12', pool='azure_prod'})
newServer({name='prod2', address='142.1.78.13', pool='azure_prod'})
newServer({name='prod3', address='142.1.78.14', pool='azure_prod'})
newServer({name='prod4', address='142.1.78.15', pool='azure_prod'})
newServer({name='qa1', address='142.150.247.12', pool='azure_qa'})
newServer({name='qa2', address='142.150.247.13', pool='azure_qa'})
newServer({name='qa3', address='142.150.247.14', pool='azure_qa'})
newServer({name='qa4', address='142.150.247.15', pool='azure_qa'})
newServer({name='blackhole', address='128.100.100.130', pool='typo'})

-- Azure Pools

{% for pool_name, ns_map in azure_pool_ns.items() %}
-- Pool {{pool_name}}
{% for ns_name, ns_ip in ns_map.items() %}
newServer({name='{{ns_name}}', address='{{ ns_ip }}', pool='{{ pool_name }}'})
{% endfor %}
setPoolServerPolicy(roundrobin, '{{ pool_name }}')

{% endfor %}

-- Packet Caches
pc = newPacketCache(100000)
getPool(''):setCache(pc)

-- Dynamic Blocks
local dbr = dynBlockRulesGroup()
dbr:setQueryRate(60, 15, 'Exceeded query rate', 60)
dbr:setRCodeRate(DNSRCode.NXDOMAIN, 60, 15, 'Exceeded NXD rate', 60)
dbr:setRCodeRate(DNSRCode.SERVFAIL, 60, 15, 'Exceeded ServFail rate', 60)
dbr:setQTypeRate(DNSQType.ANY, 40, 15, 'Exceeded ANY rate', 60)
dbr:setResponseByteRate(40000, 15, 'Exceeded Byte rate', 60)

-- NetMask Groups
-- These CIDR blocks represent source addresses that can be redirected to the Azure pool.

az_nmg = newNMG()
{% for net in uoft_onprem_nets %}
az_nmg:addMask('{{net}}')
{% endfor %}

-- Suffix Match Nodes
-- These names represent the set of Azure Resource Private Names

-- Azure private names
azure_priv_smn = newSuffixMatchNode()
{% for priv_name in azure_private_zones %}
azure_priv_smn:add('{{priv_name}}.')
{% endfor %}

-- Azure public names mapped to pools

-- Common regex to exclude .privatelink. queries
has_privatelink = RegexRule('\\.privatelink\\.')

-- Azure Pool Configurations
{% for pool_name, domain_list in azure_pools.items() %}
-- Pool: {{ pool_name }} ({{ domain_list | length }} domains)
{{ pool_name | replace('-', '_') }}_smn = newSuffixMatchNode()
{% for domain in domain_list %}
{{ pool_name | replace('-', '_') }}_smn:add('{{ domain }}.')
{% endfor %}

{{ pool_name | replace('-', '_') }}_rule = SuffixMatchNodeRule({{ pool_name | replace('-', '_') }}_smn)

addAction(
    AndRule({
        {{ pool_name | replace('-', '_') }}_rule,
        NotRule(has_privatelink)
    }),
    PoolAction('{{ pool_name }}')
)

{% endfor %}

-- Local forward suffixes
local_smn = newSuffixMatchNode()
{% for zone in uoft_forward_zones %}
local_smn:add('{{zone}}.')
{% endfor %}

-- Local reverse DNS / ARPA suffixes
arpa_smn = newSuffixMatchNode()
{% for zone in uoft_reverse_zones %}
arpa_smn:add('{{zone}}.')
{% endfor %}

-- Bogus Type suffixes
typo_smn = newSuffixMatchNode()
{% for zone in uoft_typo_zones %}
typo_smn:add('{{zone}}.')
{% endfor %}

-- Selector Matching Rules

-- Name Prefix Regex based rules

-- IRDG and AMS legacy naming prefixes
irdg_prefix = RegexRule('^IDH[PN]')
ams_prefix = RegexRule('^[DQPMS]301[A-Z0-9_-]+\\.')
lemon_prefix = RegexRule('^LEMONMOSS')
-- Conforming names
std_prod_prefix = RegexRule('^[MNP][0-9]{3}[A-Z0-9_-]+\\.')
std_qa_prefix = RegexRule('^[QA][0-9]{3}[A-Z0-9_-]+\\.')

-- Network and Suffix Rules
azure_net = NetmaskGroupRule(az_nmg)
local_name_rule = SuffixMatchNodeRule(local_smn)
arpa_rule = SuffixMatchNodeRule(arpa_smn)
typo_rule = SuffixMatchNodeRule(typo_smn)

-- Logical Combination of Prefix Matching Rules
prod_prefix = OrRule({std_prod_prefix, ams_prefix, irdg_prefix, lemon_prefix})
azure_prefix = OrRule({prod_prefix, std_qa_prefix})

-- Azure DNS Suffix matching rules
azure_priv_suffix = SuffixMatchNodeRule(azure_priv_smn)
azure_pub_suffix = SuffixMatchNodeRule(azure_pub_smn)

-- Selectors
prod_selector = AndRule({azure_net, prod_prefix, azure_priv_suffix})
qa_selector = AndRule({azure_net, std_qa_prefix, azure_priv_suffix})
no_recurse_selector = AndRule({azure_net, azure_prefix, azure_pub_suffix})

-- Actions
addAction(local_name_rule, PoolAction('local'))
addAction(arpa_rule, PoolAction('local'))
addAction(qa_selector, PoolAction('azure_qa'))
addAction(prod_selector, PoolAction('azure_prod'))
addAction(no_recurse_selector, PoolAction('local'))
addAction(typo_rule, PoolAction('typo'))
